{
  "name": "academic-course-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "check:content": "node scripts/check-content.mjs",
    "files:push": "node scripts/course-files.mjs push",
    "files:pull": "node scripts/course-files.mjs pull",
    "files:status": "node scripts/course-files.mjs status",
    "predeploy": "npm run check:content && npm run build",
    "deploy": "gh-pages -d dist --dotfiles -m \"Deploy site\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "js-yaml": "^5.4.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
